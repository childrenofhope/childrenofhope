---
/**
 * Photo area. Pass `src` to show a real photo; otherwise renders a tasteful
 * on-brand placeholder. To add real classroom photos later, drop a file in
 * /public/assets/images/ and pass its path as `src` (see DEPLOY.md).
 */
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  icon?: string;
  tone?: "sky" | "sage" | "peach";
  radius?: number;
  aspect?: string;
  minHeight?: number;
  fill?: boolean;
  class?: string;
}

const {
  src,
  alt = "",
  label = "Photo coming soon",
  icon = "📷",
  tone = "sky",
  radius = 22,
  aspect,
  minHeight,
  fill = false,
  class: className = "",
} = Astro.props;

const tones = {
  sky: "linear-gradient(135deg, #BFE0F2 0%, #CDE7B0 100%)",
  sage: "linear-gradient(135deg, #CDE7B0 0%, #F8D8B0 100%)",
  peach: "linear-gradient(135deg, #F8D8B0 0%, #BFE0F2 100%)",
};

const style = [
  `border-radius:${radius}px`,
  aspect ? `aspect-ratio:${aspect}` : "",
  minHeight ? `min-height:${minHeight}px` : "",
  fill ? "width:100%;height:100%" : "width:100%",
]
  .filter(Boolean)
  .join(";");
---

{
  src && fill ? (
    // Cover-fill a flexible cell (e.g. the faith / philosophy bands): the wrapper
    // takes its height from the grid row (min-height floor), the image covers it —
    // it must NOT dictate height from its own aspect ratio.
    <div
      class={`img-slot fill ${className}`}
      style={`position:relative;overflow:hidden;border-radius:${radius}px;${minHeight ? `min-height:${minHeight}px;` : ""}`}
    >
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;"
      />
    </div>
  ) : src ? (
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class={`img-slot ${className}`}
      style={`${style};object-fit:cover;display:block;`}
    />
  ) : (
    <div
      class={`img-slot placeholder ${className}`}
      style={`${style};background:${tones[tone]};`}
      role="img"
      aria-label={alt || label}
    >
      <span class="ico" aria-hidden="true">{icon}</span>
      <span class="cap">{label}</span>
    </div>
  )
}

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--coh-ink);
    text-align: center;
    padding: 24px;
  }
  .placeholder .ico { font-size: 40px; opacity: 0.9; }
  .placeholder .cap { font-size: 12px; font-weight: 700; color: rgba(44, 62, 80, 0.55); }
</style>
