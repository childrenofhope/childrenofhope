---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getAnnouncements, formatLongDate, isExternal } from "../utils";
import newsletters from "../data/newsletters.json";

const all = getAnnouncements();
const featured = all.find((a) => a.featured);
const recent = all.filter((a) => a !== featured);
const current = newsletters.find((g) => g.current);
---

<BaseLayout
  title="Announcements"
  description="The latest news and updates from Children of Hope, plus our monthly newsletter archive."
>
  <PageHero
    eyebrow="News & updates"
    title="Announcements."
    lead="The latest news from Children of Hope, plus our monthly newsletter archive."
  />

  {featured && (
    <section class="coh-pad featured-wrap">
      <div class="featured">
        <div class="f-badge">Posted {formatLongDate(featured.date)}</div>
        <div class="f-title">{featured.title}</div>
        <p class="f-copy">{featured.summary}</p>
      </div>
    </section>
  )}

  <section class="coh-2 coh-pad layout">
    <div>
      <h2 class="col-h">Recent announcements</h2>
      <div class="ann-list">
        {recent.map((a) => (
          <a class="coh-card ann" href={a.href} {...(isExternal(a.href) ? { target: "_blank", rel: "noopener" } : {})}>
            <div class="ann-date">Posted {formatLongDate(a.date)}</div>
            <div class="ann-title">{a.title}</div>
            <p class="ann-sum">{a.summary} <span class="read">Read →</span></p>
          </a>
        ))}
      </div>
    </div>

    {current && (
      <aside class="archive">
        <div class="a-title">Newsletter archive</div>
        <p class="a-sub">{current.year} school year</p>
        <div class="a-links">
          {current.issues.map((n) => (
            <a class="coh-link a-link" href={n.href}><span>📄 {n.label}</span><span class="dl" aria-hidden="true">↓</span></a>
          ))}
        </div>
        <a class="coh-link a-more" href="/newsletter">View all newsletters →</a>
      </aside>
    )}
  </section>
</BaseLayout>

<style>
  .featured-wrap { padding-top: 40px; padding-bottom: 16px; }
  .featured { background: var(--coh-gold); border-radius: 24px; padding: 38px; color: #fff; box-shadow: 0 14px 30px rgba(242,165,22,.3); }
  .f-badge { display: inline-block; background: rgba(255,255,255,.22); padding: 5px 12px; border-radius: var(--coh-r-pill); font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 14px; }
  .f-title { font-weight: 800; font-size: 26px; line-height: 1.2; margin-bottom: 10px; max-width: 680px; }
  .f-copy { font-size: 16px; line-height: 1.65; opacity: .95; margin: 0 0 22px; max-width: 640px; }

  .layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 30px; padding-top: 24px; padding-bottom: 72px; align-items: start; }
  .col-h { font-weight: 800; font-size: 22px; color: var(--coh-ink); margin: 0 0 18px; }
  .ann-list { display: flex; flex-direction: column; gap: 14px; }
  .ann { display: block; background: #fff; border-radius: 18px; padding: 22px 24px; box-shadow: 0 4px 12px rgba(44,62,80,.05); }
  .ann-date { font-size: 11px; color: var(--coh-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .ann-title { font-weight: 800; font-size: 17px; color: var(--coh-ink); margin-top: 5px; }
  .ann-sum { font-size: 14px; color: #7a7f86; margin: 6px 0 0; line-height: 1.6; }
  .read { color: var(--coh-sky); font-weight: 700; }

  .archive { background: #fff; border-radius: var(--coh-r-card); padding: 28px; box-shadow: var(--coh-shadow-card); }
  .a-title { font-weight: 800; font-size: 18px; color: var(--coh-ink); margin-bottom: 6px; }
  .a-sub { font-size: 13px; color: var(--coh-muted); margin: 0 0 18px; }
  .a-links { display: flex; flex-direction: column; }
  .a-link { display: flex; justify-content: space-between; align-items: center; padding: 13px 0; border-bottom: 1px solid rgba(10,10,10,.08); font-size: 15px; font-weight: 600; color: var(--coh-ink); }
  .a-link .dl { color: var(--coh-sky); }
  .a-more { display: inline-block; margin-top: 16px; font-weight: 700; color: var(--coh-sky); font-size: 14px; }
</style>
