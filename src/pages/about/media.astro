---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

const press = [
  {
    title: "Spotlight on Children of Hope Child Development Center: Shaping Futures Every Day",
    source: "ELCA Schools and Learning Centers",
    date: "December 2024",
    href: "https://elcaschools.org/children-of-hope-child-development-center-shaping-futures-with-love-and-learning/",
  },
  {
    title: "Parents say Quality First helped their children with a strong start for kindergarten",
    source: "First Things First",
    date: "September 29, 2022",
    href: "https://www.firstthingsfirst.org/2022/09/parents-say-quality-first-arizona-preschool-helped-their-children/",
  },
  {
    title: "Following COVID-19 protocols ‘is key’ to keeping preschool open in Ahwatukee",
    source: "ABC 15 News Arizona",
    date: "February 17, 2021",
    href: "https://www.abc15.com/news/state-of-education/following-covid-19-protocols-is-key-to-keeping-preschool-open-in-ahwatukee",
  },
  {
    title: "Pastor Steve retires from Esperanza Lutheran",
    source: "Ahwatukee Foothills News",
    date: "November 5, 2019",
    href: "https://www.ahwatukee.com/community_focus/article_dd27ea8a-fa9f-11e9-9712-2b3cd478b933.html",
  },
  {
    title: "Children of Hope preschool marks a decade",
    source: "Ahwatukee Foothills News",
    date: "March 5, 2017",
    href: "https://www.ahwatukee.com/community_focus/article_69fc1d60-febc-11e6-b5b7-173c3a7bb9f6.html",
  },
  {
    title: "Children of Hope preschool celebrating 10 years in Ahwatukee",
    source: "Ahwatukee Foothills News",
    date: "October 14, 2016",
    href: "http://www.ahwatukee.com/community_focus/article_8c3248b0-917e-11e6-8a2b-27c24d7fafe0.html",
  },
  {
    title: "Young Ahwatukee green thumbs, community garden benefit from 2 grants",
    source: "Ahwatukee Foothills News",
    date: "September 24, 2016",
    href: "http://www.ahwatukee.com/arts_life/article_5fc38982-81bc-11e6-bc1c-fbf8d86e8b8a.html",
  },
];
---

<BaseLayout
  title="In The News"
  description="Children of Hope in the news — features from ELCA Schools, First Things First, ABC 15 and the Ahwatukee Foothills News."
>
  <PageHero
    eyebrow="In the news"
    title="Children of Hope in the community."
    lead="A look at our preschool through the years, in the words of our community and partners."
  />

  <section class="coh-pad press">
    {press.map((a) => (
      <a class="coh-card item" href={a.href} target="_blank" rel="noopener">
        <div class="item-main">
          <div class="item-title">{a.title}</div>
          <div class="item-meta"><strong>{a.source}</strong> · {a.date}</div>
        </div>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .press { padding-top: 40px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 14px; }
  .item { display: flex; gap: 18px; align-items: center; background: #fff; border-radius: 18px; padding: 24px 26px; box-shadow: var(--coh-shadow-card); }
  .item-main { flex: 1; }
  .item-title { font-weight: 800; font-size: 17px; line-height: 1.4; color: var(--coh-ink); }
  .item-meta { font-size: 13px; color: var(--coh-muted); margin-top: 6px; }
  .item-meta strong { color: var(--coh-green); }
  .arrow { color: var(--coh-sky); font-weight: 700; font-size: 20px; flex: none; }
</style>
