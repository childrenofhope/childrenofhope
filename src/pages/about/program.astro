---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ImageSlot from "../../components/ImageSlot.astro";

const programs = [
  {
    icon: "🧸",
    tone: "sky",
    title: "2-Year-Old Program",
    schedule: "3 days/week · 3.5 hours",
    body: [
      "Our two year old class is a 3.5 hour class that meets three days a week in which a variety of developmentally appropriate learning activities occur. Structuring the environment and planning activities for self-directed play and learning is a fundamental part of the program.",
      "Curriculum activities include dramatic play, open-ended creative and sensory experiences (painting, sand and water play, modeling clay, collage activities, etc), construction activities with blocks and manipulative toys, gardening, cooking and outdoor activities.",
    ],
  },
  {
    icon: "🖍️",
    tone: "sage",
    title: "3-Year-Old Program",
    schedule: "3 days/week · 3.5 hours",
    body: [
      "Our three year old classes meet for 3.5 hours each day, three days per week. The class works toward helping the children verbalize their feelings and needs and in developing positive social relations. \u201CTell him how you feel\u201D is heard often with three-year-olds.",
      "At three, there is more role-play and more cooperative play. By the end of the year, playgroups have often increased in size with four or five children interacting in the housekeeping corner or on the playground with imaginative play. There are group times, which include songs, stories, finger plays, art, music, and fun body movement activities. In addition, basic introduction into early childhood academics is explored.",
    ],
  },
  {
    icon: "🎒",
    tone: "peach",
    title: "4-Year-Old Program (Pre-K)",
    schedule: "4 days/week · 2 long + 2 short days",
    body: [
      "Our four year old pre-kindergarten classes go to school 4 days per week. We have found that having two long days and two short days really helps to prepare them for Kindergarten. Monday and Wednesday go from 8:30-2:00 and Tuesday and Thursday go from 8:30-12:00. All children in this group, by age, will be eligible for Kindergarten the following year.",
      "A typical day in this program will provide developmentally appropriate experiences in all domains: cognitive, social, emotional, physical and spiritual. This theme and center-based program allows children to utilize materials in more complex and extended ways. Near the end of the year, the staff discusses with the parents their perception of the children\u2019s readiness for Kindergarten.",
    ],
  },
];

const extras = [
  {
    icon: "🥪",
    title: "Lunch Bunch",
    tag: "Optional later release",
    body: [
      "Lunch Bunch is offered each Tuesday, Wednesday and Thursday except for one day a month that it is not offered due to a Staff Meeting. Children pack their own lunch and can stay till 2:00 daily. There is an additional charge for lunch bunch.",
    ],
  },
  {
    icon: "🎉",
    title: "Fun Fridays",
    tag: "Optional Friday Class",
    body: [
      "In this optional class, offered on Fridays several times throughout the year. Each Friday will have a different theme. We have offered Stories and Fairytales, cooking, obstacle course and heart health, spooky science and more. This is a fun way to get to meet kids from other classes and meet all the different teachers. There is an additional charge for Fun Friday.",
    ],
  },
];
---

<BaseLayout
  title="Our Program"
  description="A hands-on Christian learning environment for 2s, 3s and Pre-K — nurturing each child's spiritual, social-emotional, cognitive and physical growth."
>
  <PageHero
    eyebrow="Our program"
    title="A day full of wonder."
    lead="Children of Hope is committed to providing a positive and hands-on Christian learning environment."
  />

  <!-- BANNER -->
  <section class="coh-pad" style="padding-top:28px;">
    <ImageSlot src="/assets/images/play.jpg" alt="Children at play at Children of Hope" aspect="16/6" radius={22} />
  </section>

  <!-- INTRO -->
  <section class="coh-pad intro-wrap">
    <div class="intro">
      <p>
        We will nurture the students’ spiritual, social-emotional, cognitive and physical growth
        through a child-centered developmental curriculum.
      </p>
      <p>
        We form a true partnership with the family to build a strong foundation that will foster a
        life-long love of learning. A strong Christian foundation is developed through participation
        in Chapel, Bible stories, songs and prayers.
      </p>
      <p class="intro-note">Children of Hope is an active member of the Evangelical Lutheran Education Association.</p>
    </div>
  </section>

  <!-- AGE PROGRAMS -->
  <section class="coh-pad programs">
    {programs.map((p) => (
      <article class="program">
        <span class={`p-ico ${p.tone}`} aria-hidden="true">{p.icon}</span>
        <div class="p-body">
          <div class="p-head">
            <h2>{p.title}</h2>
            <span class="p-chip">{p.schedule}</span>
          </div>
          {p.body.map((t) => <p>{t}</p>)}
        </div>
      </article>
    ))}
  </section>

  <!-- EXTRAS -->
  <section class="coh-2 coh-pad extras">
    {extras.map((e) => (
      <article class="extra">
        <span class="e-ico" aria-hidden="true">{e.icon}</span>
        <div>
          <div class="e-tag">{e.tag}</div>
          <h3>{e.title}</h3>
          {e.body.map((t) => <p>{t}</p>)}
        </div>
      </article>
    ))}
  </section>

  <!-- CTA -->
  <section class="coh-pad cta-wrap">
    <div class="cta">
      <div>
        <div class="cta-title">Ready to learn more?</div>
        <p>Download the Family Handbook for full schedules, ages and fees.</p>
      </div>
      <a class="coh-btn cta-btn" href="/forms">Go to Forms &amp; Handbook</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-wrap { padding-top: 40px; }
  .intro { max-width: 760px; }
  .intro p { font-size: 17px; line-height: 1.7; color: var(--coh-body); margin: 0 0 12px; }
  .intro-note { font-weight: 700; color: var(--coh-green) !important; font-size: 15px !important; }

  .programs { padding-top: 40px; display: flex; flex-direction: column; gap: 18px; }
  .program { display: flex; gap: 22px; background: #fff; border-radius: var(--coh-r-card); padding: 30px; box-shadow: var(--coh-shadow-card); }
  .p-ico { width: 64px; height: 64px; flex: none; border-radius: 18px; display: grid; place-items: center; font-size: 30px; }
  .p-ico.sky { background: var(--coh-sky-soft); }
  .p-ico.sage { background: var(--coh-sage); }
  .p-ico.peach { background: var(--coh-peach); }
  .p-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 10px; }
  .p-head h2 { font-weight: 800; font-size: 21px; color: var(--coh-ink); margin: 0; letter-spacing: -.01em; }
  .p-chip { font-size: 12px; font-weight: 700; color: var(--coh-sky); background: var(--coh-sky-soft); padding: 5px 12px; border-radius: var(--coh-r-pill); }
  .program p { font-size: 15px; line-height: 1.7; color: #6b7077; margin: 0 0 12px; }
  .program p:last-child { margin-bottom: 0; }

  .extras { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding-top: 18px; }
  .extra { display: flex; gap: 16px; background: var(--coh-paper-2); border-radius: 20px; padding: 26px; }
  .e-ico { font-size: 30px; }
  .e-tag { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--coh-green); margin-bottom: 4px; }
  .extra h3 { font-weight: 800; font-size: 18px; color: var(--coh-ink); margin: 0 0 6px; }
  .extra p { font-size: 14px; line-height: 1.6; color: #6b7077; margin: 0 0 10px; }
  .extra p:last-child { margin-bottom: 0; }

  .cta-wrap { padding-top: 48px; padding-bottom: 72px; }
  .cta { background: var(--coh-sky); border-radius: 24px; padding: 40px; color: #fff; box-shadow: var(--coh-shadow-sky); display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta-title { font-weight: 800; font-size: 24px; line-height: 1.2; margin-bottom: 8px; }
  .cta p { font-size: 15px; line-height: 1.6; opacity: .92; margin: 0; max-width: 560px; }
  .cta-btn { background: #fff; color: var(--coh-ink); padding: 14px 24px; border-radius: var(--coh-r-pill); font-weight: 700; font-size: 14px; white-space: nowrap; }

  @media (max-width: 860px) {
    .program { flex-direction: column; gap: 16px; }
  }
</style>
