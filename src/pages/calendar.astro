---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

type EventType = "session" | "noschool";
interface CalEvent { date: string; label: string; type: EventType; }

/**
 * Notable days and holidays, mirroring COH_Calendar.pdf for 2026–2027 — the formal
 * holiday list. The fuller Yearly Calendar of Events PDF is linked below as well.
 */
const events: CalEvent[] = [
  { date: "August 3 & 4", label: "First Days of Class", type: "session" },
  { date: "September 7", label: "Labor Day", type: "noschool" },
  { date: "Sept. 28 – Oct. 12", label: "Fall Break", type: "noschool" },
  { date: "October 13", label: "Classes Resume", type: "session" },
  { date: "November 11", label: "Veterans Day", type: "noschool" },
  { date: "November 25 – 27", label: "Thanksgiving Break", type: "noschool" },
  { date: "Dec. 21 – Jan. 4", label: "Winter Break", type: "noschool" },
  { date: "January 5", label: "Classes Resume", type: "session" },
  { date: "January 18", label: "Martin Luther King Jr. Day", type: "noschool" },
  { date: "February 15", label: "Presidents' Day", type: "noschool" },
  { date: "March 8 – 22", label: "Spring Break", type: "noschool" },
  { date: "March 23", label: "Classes Resume", type: "session" },
  { date: "May 20", label: "Last Day of School", type: "session" },
];
---

<BaseLayout
  title="Calendar"
  description="The 2026–2027 Children of Hope preschool calendar — notable days and holidays, based on the Kyrene School District calendar."
>
  <PageHero eyebrow="School calendar" title="Preschool Calendar 2026–2027">
    <p slot="lead" class="lead">
      Notable days and holidays for the preschool academic year, based on the Kyrene School
      District. We follow this as closely as possible and will notify you of any changes the
      district or we might make.
    </p>
  </PageHero>

  <section class="coh-pad cal">
    <ul class="events">
      {events.map((e) => (
        <li class={`event ${e.type}`}>
          <span class="tag">{e.type === "noschool" ? "No School" : "Session"}</span>
          <span class="date">{e.date}</span>
          <span class="label">{e.label}</span>
        </li>
      ))}
    </ul>
    <div class="downloads">
      <a class="coh-btn full-cal" href="/assets/forms/2026-2027/COH_Yearly_Calendar_of_Events.pdf">
        Yearly calendar of events (PDF) ↓
      </a>
      <a class="coh-btn full-cal" href="/assets/forms/2026-2027/COH_Calendar.pdf">
        Holidays &amp; no-school days (PDF) ↓
      </a>
    </div>
    <p class="note">
      The yearly calendar lists everything — parties, Fun Fridays, conferences, board meetings and
      program days. Dates on it are for planning and may shift.
    </p>
  </section>
</BaseLayout>

<style>
  .lead { font-size: 19px; line-height: 1.6; color: var(--coh-body); margin: 0; max-width: 640px; }

  .cal { padding-top: 40px; padding-bottom: 72px; }
  .events { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .event {
    display: grid;
    grid-template-columns: 110px 200px 1fr;
    align-items: center;
    gap: 18px;
    background: #fff;
    border-radius: 16px;
    padding: 18px 22px;
    box-shadow: var(--coh-shadow-card);
    border-left: 5px solid var(--coh-sage);
  }
  .event.noschool { border-left-color: var(--coh-gold); }
  .tag {
    justify-self: start;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em;
    padding: 5px 12px; border-radius: var(--coh-r-pill);
    background: var(--coh-sage); color: #3f5a47;
  }
  .event.noschool .tag { background: var(--coh-peach); color: #8a5a14; }
  .date { font-weight: 800; color: var(--coh-ink); font-size: 15px; }
  .label { color: var(--coh-body); font-size: 15px; }

  .downloads { display: flex; flex-wrap: wrap; gap: 12px; }
  .full-cal { display: inline-block; background: var(--coh-paper-2); color: var(--coh-ink); padding: 14px 24px; border-radius: var(--coh-r-pill); font-weight: 700; font-size: 14px; }
  .note { margin: 14px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--coh-muted); max-width: 560px; }

  @media (max-width: 640px) {
    .event { grid-template-columns: 1fr; gap: 6px; }
    .tag { margin-bottom: 4px; }
  }
</style>
